# Copy to .env.production for production frontend builds and live readiness checks.
# Do not commit real .env.production values.

VITE_API_BASE_URL=https://api.insertplayer.ai
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
VITE_PUBLIC_APP_NAME=Insert Player
VITE_PUBLIC_APP_SHORT_NAME=P1
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA_replace_me

# Consumed by `npm run config:live` to patch Worker vars/secrets.
CLERK_ISSUER=https://clerk.insertplayer.ai
# Optional JWKS override. CLERK_ISSUER is still required for issuer validation.
# CLERK_JWKS_URL=https://clerk.insertplayer.ai/.well-known/jwks.json
# Production auth/API origins are intentionally limited to apex + www. Clerk live keys do not support Pages preview domains.
CORS_ORIGIN=https://insertplayer.ai,https://www.insertplayer.ai
CLERK_AUTHORIZED_PARTIES=https://insertplayer.ai,https://www.insertplayer.ai
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
ANONYMIZATION_SECRET=replace_me_with_at_least_32_random_bytes
STRIPE_ACCOUNT_ID=acct_1U5w8DCQ9OPSWOkj
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_VERSUS=price_replace_me
STRIPE_PRICE_ARCADE=price_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional safety denylist for any shared company Stripe accounts that must never be used here.
# ASF_FORBIDDEN_STRIPE_ACCOUNT_IDS=acct_shellbot_replace_me
TURNSTILE_SECRET_KEY=0x4AAAAAA_replace_me
TURNSTILE_HOSTNAMES=insertplayer.ai,www.insertplayer.ai

# Source views are canonical and should stay Pro regardless of quality tier.
VITE_GEMINI_IMAGE_MODEL_REPOSE=gemini-3-pro-image
VITE_GEMINI_IMAGE_MODEL_UPRIGHT=gemini-3-pro-image
VITE_GEMINI_IMAGE_MODEL_CROUCH=gemini-3-pro-image

VITE_BG_REMOVAL_PROVIDER=fal
VITE_INTRO_VIDEO_PROVIDER=fal-ltx-v2-3-fast

# Shell vars for post-deploy verification; export them before running scripts.
# Public launch brand must be chosen and cleared before Clerk/Stripe/Pages launch.
ASF_PUBLIC_APP_NAME=Insert Player
ASF_PUBLIC_APP_SHORT_NAME=P1
ASF_SOCIAL_CARD_PATH=/assets/social-card.png
