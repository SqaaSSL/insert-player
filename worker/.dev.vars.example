GENERATION_JOB_SIGNING_SECRET=replace_me_with_at_least_32_random_bytes
CLERK_BACKEND_AUTH_BRIDGE_SECRET=replace_me_with_at_least_32_random_bytes
TURNSTILE_REQUIRED=false
TURNSTILE_ACTION=anonymous_rookie

GEMINI_TRANSPORT=google-direct
METERKEY_BASE_URL=https://meter.hilo.cx
PIXCLI_BASE_URL=https://pixcli.hilo.cx

