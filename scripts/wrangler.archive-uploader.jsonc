{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "insert-player-archive-uploader",
  "main": "archive-r2-upload-worker.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "insert-player-assets",
      "jurisdiction": "eu"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
