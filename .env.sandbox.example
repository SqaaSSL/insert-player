# Copy to .env.sandbox.local for the isolated Cloudflare/Clerk/Stripe sandbox.
# Never put live keys or production resource ids in this file.

VITE_API_BASE_URL=https://insert-player-api-sandbox.shellbot.workers.dev
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_PUBLIC_APP_NAME=Insert Player
VITE_PUBLIC_APP_SHORT_NAME=P1
# Cloudflare's always-pass visible test widget. Never use this in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

CLERK_ISSUER=https://your-sandbox.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-sandbox.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=https://insert-player-sandbox.pages.dev,http://localhost:5173,http://127.0.0.1:5174
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
ANONYMIZATION_SECRET=replace_me_with_at_least_32_random_bytes
GENERATION_JOB_SIGNING_SECRET=replace_me_with_at_least_32_random_bytes

# These must belong to the dedicated Insert Player account's sandbox.
STRIPE_ACCOUNT_ID=acct_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_VERSUS=price_replace_me
STRIPE_PRICE_ARCADE=price_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ASF_STRIPE_WEBHOOK_URL=https://insert-player-api-sandbox.shellbot.workers.dev/api/billing/stripe-webhook
# Keep the ShellBot account id here so the bootstrap refuses it.
# ASF_FORBIDDEN_STRIPE_ACCOUNT_IDS=acct_shellbot_replace_me

# Source views remain Gemini Pro in every environment and quality tier.
VITE_GEMINI_IMAGE_MODEL_REPOSE=gemini-3-pro-image
VITE_GEMINI_IMAGE_MODEL_UPRIGHT=gemini-3-pro-image
VITE_GEMINI_IMAGE_MODEL_CROUCH=gemini-3-pro-image
VITE_BG_REMOVAL_PROVIDER=fal
VITE_INTRO_VIDEO_PROVIDER=fal-ltx-v2-3-fast

ASF_SANDBOX_WORKER_URL=https://insert-player-api-sandbox.shellbot.workers.dev
ASF_SANDBOX_PAGES_PROJECT_NAME=insert-player-sandbox
ASF_SANDBOX_FRONTEND_URL=https://insert-player-sandbox.pages.dev
# worker/wrangler.sandbox.toml keeps ANONYMOUS_ROOKIE_ENABLED=false so public
# QA traffic cannot mint provider sessions before authenticated testing.
