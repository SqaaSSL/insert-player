FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS build

WORKDIR /app
COPY processor/package.json processor/package-lock.json ./processor/
RUN npm ci --prefix processor

COPY processor ./processor
COPY src/services ./src/services
RUN npm run --prefix processor build
RUN npm prune --prefix processor --omit=dev

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app
COPY --from=build /app/processor/dist ./processor/dist
COPY --from=build /app/processor/node_modules ./processor/node_modules
EXPOSE 8080
USER node
CMD ["node", "processor/dist/server.mjs"]
